theorem FrontierAHS27.embedded_AHS_extra_disjoint.{u} : ∀ {α : Type u} [inst : DecidableEq α] (e : Fin 9 ↪ α)
  (F : Finset (Finset α)),
  IsSunflowerFree F 3 →
    Erdos20FiniteReduction.mapFamily e FrontierAHS27.AHS ⊆ F →
      ∀ C ∈ F,
        C.card ≤ 4 →
          C ∉ Erdos20FiniteReduction.mapFamily e FrontierAHS27.AHS → Disjoint C (FrontierAHS27.blockSupport e) :=
fun {α} [DecidableEq α] e F hfree hcontain C hC hcard hout =>
  FrontierAHS27.embedded_AHS_extra_disjoint_of_trace_property FrontierAHS27.trace_blockers e F hfree hcontain C hC hcard
    hout
